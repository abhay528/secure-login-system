{
  "name": "secure-login-system",
  "version": "1.0.0",
  "description": "A secure authentication web app with bcrypt password hashing, input validation, SQL-injection-safe queries, session management, and optional TOTP two-factor authentication.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js"
  },
  "keywords": [
    "authentication",
    "security",
    "bcrypt",
    "express",
    "2fa",
    "totp",
    "sessions",
    "sqlite",
    "nodejs"
  ],
  "author": "Abhay Jadon",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^11.3.0",
    "connect-sqlite3": "^0.9.15",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0"
  }
}
