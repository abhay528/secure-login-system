<%- include('partials/header') %>
<div class="card auth-card">
  <h1>Create your account</h1>
  <p class="muted">Passwords are hashed with bcrypt and never stored in plain text.</p>

  <% if (errors.length) { %>
    <div class="flash flash-error">
      <ul>
        <% errors.forEach(function (e) { %><li><%= e.msg %></li><% }); %>
      </ul>
    </div>
  <% } %>

  <form action="/register" method="POST" novalidate>
    <label>Username
      <input type="text" name="username" value="<%= values.username || '' %>" required autofocus />
    </label>
    <label>Email
      <input type="email" name="email" value="<%= values.email || '' %>" required />
    </label>
    <label>Password
      <input type="password" name="password" required />
    </label>
    <label>Confirm password
      <input type="password" name="confirmPassword" required />
    </label>
    <button type="submit" class="btn btn-primary btn-block">Create account</button>
  </form>

  <p class="muted center" style="margin-top:20px">
    Already have an account? <a href="/login">Log in</a>
  </p>
</div>
<%- include('partials/footer') %>
